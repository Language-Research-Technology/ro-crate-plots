{
  "plots": {
    "globalConfig": {
      "actions": false
    },
    "datasets": {
      "RepositoryObject": {
        "path": "../data/ro-crate_RepositoryObject.csv"
      }
    },
    "plotList": [
      {
        "dataset": {
          "name": "RepositoryObject"
        },
        "makeSpec": {
          "plotFunction": "barPlotCount",
          "args": {
            "xVar": "dataset_name",
            "xTitle": "Dataset",
            "xLabels": {
              "Sydney Social Dialect Survey (SSDS)": "SSDS",
              "NSW Bicentennial Oral History Project (BCNT)": "BCNT",
              "ANU Corpus of Sydney Speech": "ACSS"
            },
            "yTitle": "count",
            "data": "RepositoryObject",
            "title": "Counts of speakers"
          }
        },
        "generatedSpec": {},
        "customSpec": {},
        "plotCardSpan": 1
      },
      {
        "dataset": {
          "name": "RepositoryObject"
        },
        "makeSpec": {
          "plotFunction": "scatterPlot",
          "args": {
            "xVar": "speaker_birthDate",
            "xType": "temporal",
            "xTitle": "Year of Birth",
            "xTimeUnit": "year",
            "yVar": "dateCreated",
            "yType": "temporal",
            "yTitle": "Year of interview",
            "yTimeUnit": "year",
            "colorVar": "dataset_name",
            "colorTitle": "Dataset",
            "colorLabels": {
              "Sydney Social Dialect Survey (SSDS)": "SSDS",
              "NSW Bicentennial Oral History Project (BCNT)": "BCNT",
              "ANU Corpus of Sydney Speech": "ACSS"
            },
            "data": "RepositoryObject",
            "title": "Birth year vs. year of interview"
          }
        },
        "generatedSpec": {},
        "customSpec": {},
        "plotCardSpan": 1
      },
      {
        "dataset": {
          "name": "RepositoryObject"
        },
        "makeSpec": {
          "plotFunction": "boxPlot",
          "args": {
            "xVar": "dataset_name",
            "xTitle": "Dataset",
            "yVar": "speaker_birthDate",
            "yType": "temporal",
            "yTitle": "Birth date",
            "colorVar": "speaker_gender",
            "colorTitle": "Gender",
            "xLabels": {
              "Sydney Social Dialect Survey (SSDS)": "SSDS",
              "NSW Bicentennial Oral History Project (BCNT)": "BCNT",
              "ANU Corpus of Sydney Speech": "ACSS"
            },
            "data": "RepositoryObject",
            "title": [
              "Distribution of birth dates",
              "by dataset and gender"
            ]
          }
        },
        "generatedSpec": {},
        "customSpec": {},
        "plotCardSpan": 1
      },
      {
        "dataset": {
          "name": "RepositoryObject"
        },
        "makeSpec": {
          "plotFunction": "histogramPlot",
          "args": {
            "xVar": "dateCreated",
            "xType": "temporal",
            "xTitle": "Year of interview",
            "xTimeUnit": "year",
            "data": "RepositoryObject",
            "title": [
              "Histogram of interviews",
              "years"
            ]
          }
        },
        "generatedSpec": {},
        "customSpec": {},
        "plotCardSpan": 1
      }
    ]
  }
}